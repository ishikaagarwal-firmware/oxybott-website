# Oxybott Website & Backend Environment Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# JWT Secret for Admin Authentication
# IMPORTANT: In production, generate a cryptographically strong 64-character secret.
# In production mode (NODE_ENV=production), startup will fail if an insecure placeholder or empty secret is used.
JWT_SECRET=your_production_high_entropy_jwt_secret_here_minimum_32_chars
JWT_EXPIRES_IN=24h

# Database Configuration (Defaults to embedded SQLite with WAL mode)
DATABASE_FILE=./data/oxybott.db

# Store Settings
DEFAULT_CURRENCY=INR
CURRENCY_SYMBOL=₹
DEFAULT_LOW_STOCK_THRESHOLD=5

# Optional SMTP Email Configuration (If disabled, inquiries are securely stored in SQLite only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=admin@oxybott.com
